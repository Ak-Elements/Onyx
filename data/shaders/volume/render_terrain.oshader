#version 460 core

#include "includes/common.h"
#include "includes/bindless.h"
#include "includes/volume/volumesources.h"
#include "includes/volume/sample_terrain.h"
#include "includes/debug/print.h"

#include "includes/volume/default_terrain.h"

vertex
{
    void main()
    {
        vec2 texCoord = vec2((gl_VertexIndex << 1) & 2, gl_VertexIndex & 2);
        gl_Position = vec4(texCoord * 2.0f + -1.0f, 0.0f, 1.0f);
	    gl_Position.y = -gl_Position.y;
    }
}

fragment
{

// #include "includes/lighting.h"
    layout(std430, buffer_reference, buffer_reference_align = 8) readonly buffer ViewConstants
    {
        mat4 ProjectionMatrix;
        mat4 InverseProjectionMatrix;
        mat4 ViewMatrix;
        mat4 InverseViewMatrix;
        mat4 ViewProjectionMatrix;
        mat4 InverseViewProjectionMatrix;

        vec2 Viewport;
        float Near;
        float Far;

        vec3 CameraPosition;
        float Padding;

        vec3 CameraDirection;
        float Padding2;
    };

    layout(push_constant) uniform Constants
    {
        ViewConstants ViewConstantsBuffer; 

        WorldVolumeSourcesList VolumeSourcesList;
        WorldVolumeSources VolumeSourcesData;

        // uvec3 LightClusterGridSize;
        // float LightClusterScale;
        //
        // uvec2 LightClusterSize;
        // float LightClusterBias;
        uint TextureId0;
        uint TextureId1;
        uint TextureId2;
    } u_Constants;
    
    vec3 computeRayDirection(vec2 fragCoord, mat4 invProj, mat4 invView, vec2 viewport) {
        vec2 ndc = vec2(
            (fragCoord.x / viewport.x) * 2.0f - 1.0f,
            (fragCoord.y / viewport.y) * -2.0f + 1.0f);
        vec4 viewSpace  = invProj * vec4(ndc, 0.0f, 1.0f);
        viewSpace      /= viewSpace.w;
        viewSpace.w     = 0.0f;
        return normalize((invView * viewSpace).xyz);
    }

    layout(location = 0) out vec4 OutColor;

    float interleavedGradientNoise( vec2 screenPosition ) {
        return fract(52.9829189 * fract(dot( screenPosition , vec2( 0.06711056, 0.00583715 ))));
    }

    int selectDitheredIndex( vec3 blend, float dither ) { 
        blend = clamp(blend, 0.0, 1.0);
        int index = (blend.x - dither > blend.y) ? 0 : 1;
        float otherMax = max(blend.x, blend.y);
        index = (blend.z - dither > otherMax) ? 2 : index;
        return index;
    }

    struct TriPlanarBlendData {
        vec2 Uv;
        vec2 UvDdx;
        vec2 UvDdy;
        vec3 Tangent;
        vec3 BiTangent;
        vec3 PlaneNormal;
        int Axis;
    };

    TriPlanarBlendData triplanarBlend( vec3 position, vec3 normal, vec2 screenPosition, vec3 ddx, vec3 ddy, float blendSharpness ) {
        vec3 weights = pow ( abs( normal ), vec3( blendSharpness ) );
        weights /= ( weights.x + weights.y + weights.z );

        float dither = interleavedGradientNoise( screenPosition );

        TriPlanarBlendData blendData;
        blendData.Axis = selectDitheredIndex( weights, dither );

        if( blendData.Axis == 0 ) {
            float normalSign = sign( normal.x );
            vec2 uvRotation = vec2( normalSign, 1.0f );
            blendData.Uv = position.zy * uvRotation;
            blendData.UvDdx = ( ddx.zy * uvRotation ) - blendData.Uv;
            blendData.UvDdy = ( ddy.zy * uvRotation ) - blendData.Uv;
            blendData.Tangent = vec3( 0.0f, 0.0f, 1.0f) * normalSign;
            blendData.PlaneNormal = vec3( 1.0f, 0.0f, 0.0f ) * normalSign;
        } else if ( blendData.Axis == 1 ) {
            float normalSign = sign( normal.y );
            vec2 uvRotation = vec2( normalSign, 1.0f );
            blendData.Uv = position.xz * uvRotation;
            blendData.UvDdx = ( ddx.xz * uvRotation ) - blendData.Uv;
            blendData.UvDdy = ( ddy.xz * uvRotation ) - blendData.Uv;
            blendData.Tangent = vec3( 1.0f, 0.0f, 0.0f) * normalSign;
            blendData.PlaneNormal = vec3( 0.0f, 1.0f, 0.0f ) * normalSign;
        } else { 
            float normalSign = sign( normal.z );
            vec2 uvRotation = vec2( normalSign, 1.0f );
            blendData.Uv = position.xy * uvRotation;
            blendData.UvDdx = ( ddx.xy * uvRotation )- blendData.Uv;
            blendData.UvDdy = ( ddy.xy * uvRotation ) - blendData.Uv;
            blendData.Tangent = vec3( 1.0f, 0.0f, 0.0f) * normalSign;
            blendData.PlaneNormal = vec3( 0.0f, 0.0f, 1.0f ) * normalSign;
        }

        blendData.BiTangent = cross(blendData.Tangent, blendData.PlaneNormal);
        return blendData;
    }

    vec2 triplanarBlend( vec3 position, vec3 normal, vec2 screenPosition, float blendSharpness ) {
        vec3 weights = pow ( abs( normal ), vec3( blendSharpness ) );
        weights /= ( weights.x + weights.y + weights.z );

        float dither = interleavedGradientNoise( screenPosition );

        TriPlanarBlendData blendData;
        blendData.Axis = selectDitheredIndex( weights, dither );

        if( blendData.Axis == 0 ) {
            float normalSign = sign( normal.x );
            vec2 uvRotation = vec2( normalSign, 1.0f );
            return position.zy * uvRotation;
        } else if ( blendData.Axis == 1 ) {
            float normalSign = sign( normal.y );
            vec2 uvRotation = vec2( normalSign, 1.0f );
            return position.xz * uvRotation;
        } else { 
            float normalSign = sign( normal.z );
            vec2 uvRotation = vec2( normalSign, 1.0f );
            return position.xy * uvRotation;
        }
    }

    float getHeightScale(float distance)
    {
        float fadeStart = 0.0f;
        float fadeEnd   = 512.0f;
        float t = clamp((distance - fadeStart) / (fadeEnd - fadeStart), 0.0f, 1.0f);
        return mix(5.0f, 0.0f, t);
    }

    void main()
    {
        mat4 invProj = u_Constants.ViewConstantsBuffer.InverseProjectionMatrix;
        mat4 invView = u_Constants.ViewConstantsBuffer.InverseViewMatrix;
        vec2 viewport = u_Constants.ViewConstantsBuffer.Viewport;
        vec3 rayOrigin = u_Constants.ViewConstantsBuffer.CameraPosition;

        vec3 rayDirection = computeRayDirection(gl_FragCoord.xy, invProj, invView, viewport);
        vec3 ddx_rd = computeRayDirection(gl_FragCoord.xy + vec2(1, 0), invProj, invView, viewport);
        vec3 ddy_rd = computeRayDirection(gl_FragCoord.xy + vec2(0, 1), invProj, invView, viewport);

        float near = u_Constants.ViewConstantsBuffer.Near;
        float far = u_Constants.ViewConstantsBuffer.Far;

        bool hasHit = false;
        vec3 hitPosition;
        vec3 hitNormal;
        float distance = 0.0f;
        float heightScale;

        for (uint i = 0; i < 512; ++i)
        {
            vec3 position = rayOrigin + rayDirection * distance;
            vec4 sampleValue = SampleTerrain(position, u_Constants.VolumeSourcesList, u_Constants.VolumeSourcesData);
            float heightScale = getHeightScale( distance );
            float scaleDistance = 1.0f;
            if (heightScale > 0.0f ) {
                vec2 uv = triplanarBlend(
                        position / 100.0f,
                        sampleValue.xyz,
                        gl_FragCoord.xy,
                        8.0f
                );

                float h = textureLod(BindlessTextures[nonuniformEXT(u_Constants.TextureId1)], uv, 0.0f).r;
                sampleValue.w = sampleValue.w - ( h * heightScale );
                scaleDistance = 0.5f;
            }

            float epsilon = distance * 0.0001f;
            if (abs(sampleValue.w) <= epsilon)
            {
                hasHit = true;
                hitPosition = position;
                hitNormal = sampleValue.xyz;
                break;
            }

            distance += sampleValue.w * scaleDistance;
            if (distance > far) break;
        }

        if (hasHit)
        {
            vec3 hitDirection = rayOrigin - hitPosition; 
            float d = dot( hitDirection, hitNormal );
            vec3 ddx_pos = rayOrigin - ddx_rd * d * safeReciprocal( dot(ddx_rd, hitNormal) );
            vec3 ddy_pos = rayOrigin - ddy_rd * d * safeReciprocal( dot(ddy_rd, hitNormal) );

            vec4 clip = u_Constants.ViewConstantsBuffer.ViewProjectionMatrix * vec4(hitPosition, 1.0);
            gl_FragDepth = clip.z / clip.w;

            float cos_view_angle = abs( dot( hitNormal, rayDirection ) );
            float scale = 100.0f;
            TriPlanarBlendData blendData = triplanarBlend(
                    hitPosition / scale,
                    hitNormal,
                    gl_FragCoord.xy,
                    ddx_pos / scale,
                    ddy_pos / scale,
                    8.0f
            );

		    vec4 sampledTex = textureGrad( BindlessTextures[ nonuniformEXT( u_Constants.TextureId0 ) ], blendData.Uv, blendData.UvDdx, blendData.UvDdy );
            OutColor = vec4(sampledTex.xyz, 1.0f );
        }
        else
        {
            discard;
        }
    }
}
